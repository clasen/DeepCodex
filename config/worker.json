{
  "credentials": {"env_file": "~/.config/deepcodex/.env"},
  "codex": {
    "model": "deepseek-flash",
    "model_provider": "deepcodex-deepseek",
    "model_reasoning_effort": "high",
    "web_search": "disabled",
    "approval_policy": "never",
    "model_providers": {
      "deepcodex-deepseek": {
        "name": "DeepSeek direct",
        "base_url": "https://api.deepseek.com",
        "wire_api": "responses",
        "env_key": "DEEPSEEK_API_KEY",
        "requires_openai_auth": false,
        "supports_websockets": false,
        "request_max_retries": 4,
        "stream_max_retries": 5,
        "stream_idle_timeout_ms": 120000
      }
    },
    "agents": {"enabled": false},
    "features": {
      "multi_agent": false,
      "multi_agent_v2": false,
      "plugins": false,
      "apps": false,
      "hooks": false,
      "memories": false,
      "shell_snapshot": false,
      "context_management": {"experimental_mode": false}
    },
    "shell_environment_policy": {
      "inherit": "core",
      "ignore_default_excludes": false,
      "experimental_use_profile": false,
      "filters": {"DEEPSEEK_API_KEY": "exclude"}
    },
    "sandbox_workspace_write": {"network_access": false}
  },
  "model_metadata": {
    "display_name": "DeepSeek Flash",
    "description": "Text worker using the direct DeepSeek API.",
    "default_reasoning_level": "high",
    "supported_reasoning_levels": [
      {"effort": "low", "description": "Simple tasks"},
      {"effort": "high", "description": "Implementation"},
      {"effort": "max", "description": "Complex problems"}
    ],
    "shell_type": "shell_command",
    "visibility": "list",
    "supported_in_api": true,
    "experimental_supported_tools": [],
    "supports_image_detail_original": false,
    "comp_hash": "deepcodex-0.1.0",
    "priority": 1,
    "context_window": 1048576,
    "max_context_window": 1048576,
    "effective_context_window_percent": 95,
    "default_reasoning_summary": "none",
    "support_verbosity": false,
    "apply_patch_tool_type": "freeform",
    "truncation_policy": {"mode": "tokens", "limit": 10000},
    "input_modalities": ["text"],
    "supports_search_tool": false,
    "supports_experimental_context": false,
    "use_responses_lite": false
  },
  "limits": {
    "timeout_seconds": 900,
    "poll_interval_seconds": 0.2,
    "max_task_bytes": 65536,
    "max_output_bytes": 8388608,
    "max_result_chars": 24000,
    "max_error_chars": 2000,
    "version_timeout_seconds": 10
  }
}
